# Copy this file to .env if you want local settings later.
# .env is listed in .gitignore and must not be committed.
#
# MVP 1 does not call a language model. The null provider is always used,
# even if the values below are changed. Do not add a real API key yet.

LLM_ENABLED=false

# Leave this empty. A future optional provider may read it from the environment.
# XAI_API_KEY=
